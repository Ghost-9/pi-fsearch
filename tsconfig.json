{
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "files": [
    "index.ts",
    "src/client.ts",
    "src/types.ts",
    "src/sanitize.ts",
    "src/codemode.ts",
    "src/mcp.ts",
    "src/telemetry.ts",
    "src/observer.ts",
    "src/tool-schema.ts",
    "src/roots.ts",
    "src/config-edit.ts",
    "src/harness-registry.ts",
    "src/harness-init.ts",
    "src/history.ts",
    "src/watch.ts",
    "src/prefetch.ts",
    "src/tui.ts",
    "bin/cli.ts",
    "bin/mcp-server.ts",
    "type-stubs.d.ts"
  ]
}
