{
  "name": "pi-ultrasearch",
  "version": "0.3.1",
  "description": "Ultra-fast whole-disk filesystem search, trigram grep, and git-aware code indexing extension for Pi Agent, Antigravity & T3 Code, backed by the resident ultrasearch daemon.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ghost-9/pi-ultrasearch.git"
  },
  "homepage": "https://github.com/Ghost-9/pi-ultrasearch#readme",
  "bugs": {
    "url": "https://github.com/Ghost-9/pi-ultrasearch/issues"
  },
  "bin": {
    "ultrasearch": "./dist/bin/cli.js",
    "ultrasearch-tui": "./dist/bin/tui.js",
    "ultrasearch-mcp": "./dist/bin/mcp-server.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "index.ts",
    "type-stubs.d.ts",
    "engine/rebrand.sh",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "OPTIMIZATIONS.md",
    "AUDIT-2026-10-14.md",
    "CONTRIBUTING.md",
    "NOTICE",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test test/client.test.ts test/sanitize.test.ts test/mcp.test.ts test/client-features.test.ts test/ipc-lanes.test.ts test/fallback.test.ts test/telemetry-views.test.ts test/e2e-regressions.test.ts",
    "test:engine": "node --test --test-concurrency=1 test/engine/*.test.mjs",
    "bench:engine": "node bench/engine-ab.mjs",
    "test:gate": "node --test test/benchmark-gate.test.ts",
    "test:empirical": "node --test test/empirical-10-tests.ts",
    "bench": "node test/bench.ts",
    "bench:scopes": "node bench/run.mjs",
    "bench:scopes:json": "node bench/run.mjs --json",
    "bench:report": "node bench/report.mjs",
    "bench:tokens": "node bench/tokens.mjs",
    "bench:lanes": "node bench/lanes.mjs",
    "bench:fallback": "node bench/fallback.mjs",
    "bench:boost": "node bench/boost.mjs",
    "metrics:nightly": "node bench/nightly-summary.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:all": "npm run typecheck && npm test && npm run test:gate && npm run test:engine"
  },
  "keywords": [
    "pi-agent",
    "antigravity",
    "t3-code",
    "pi-ultrasearch",
    "ultrasearch",
    "ultrasearch-tui",
    "search",
    "grep",
    "ripgrep",
    "tantivy",
    "fast-search",
    "codemode",
    "mcp",
    "observability",
    "recursive-learning"
  ],
  "author": "Ghost-9",
  "license": "AGPL-3.0-or-later",
  "peerDependencies": {
    "typebox": ">=0.34"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
