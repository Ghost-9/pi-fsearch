<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pi.ultrasearch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/UltraSearch.app/Contents/MacOS/UltraSearch</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/batra</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/batra/Library/Application Support/UltraSearch/daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/batra/Library/Application Support/UltraSearch/daemon.log</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
